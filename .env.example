# ============================================================
# .env.example — Copy this file to .env and fill in actual values
# DO NOT commit .env with real credentials to source control.
# ============================================================

# === Rails ===
RAILS_ENV=development
SECRET_KEY_BASE=replace_with_output_of_bin_rails_secret

# === Redis (cache + ActionCable) ===
REDIS_URL=redis://redis:6379/1

# === Database (MySQL) ===
DATABASE_HOST=db
DATABASE_PORT=3306
DATABASE_USERNAME=tool_test
DATABASE_PASSWORD=your_secure_password_here
DATABASE_ROOT_PASSWORD=your_secure_root_password_here
DATABASE_NAME=tool_test_development
DATABASE_NAME_TEST=tool_test_test

# === Redmine integration ===
REDMINE_BASE_URL=https://redmine.example.com
REDMINE_USERNAME=your_redmine_username
REDMINE_PASSWORD=your_redmine_password
REDMINE_API_KEY=your_redmine_api_key_here

# === Development allowed host (optional, e.g. ngrok tunnel) ===
# DEV_ALLOWED_HOST=your-tunnel-host.ngrok-free.dev

# === Application host (mailer URL options for staging/production) ===
APP_HOST=localhost

# === SMTP (e.g. Gmail) — outgoing error notification emails ===
SMTP_ADDRESS=smtp.gmail.com
SMTP_PORT=587
SMTP_DOMAIN=gmail.com
SMTP_USERNAME=your_gmail_address@example.com
SMTP_PASSWORD=your_gmail_app_password_here
SMTP_AUTHENTICATION=plain
SMTP_ENABLE_STARTTLS_AUTO=true

# === Error Notification (ExceptionNotification) ===
ERROR_NOTIFICATION_ENABLED=false
ERROR_NOTIFICATION_SENDER=your_gmail_address@example.com
ERROR_NOTIFICATION_RECIPIENTS=admin@example.com
ERROR_NOTIFICATION_PREFIX=[tool_test][development]
ERROR_NOTIFICATION_THROTTLE_MINUTES=10

# === Background job concurrency (solid_queue) ===
JOB_CONCURRENCY=1

# === CI webhook (GitHub Actions → tooltest) ===
# Generate with: openssl rand -hex 32
# Must match the GitHub secret TOOLTEST_CI_WEBHOOK_SECRET
CI_WEBHOOK_SECRET=replace_with_openssl_rand_hex_32
# tooltest Project id where CI-imported Redmine tasks are stored
CI_DEFAULT_PROJECT_ID=1

# === Rails logging ===
# RAILS_LOG_LEVEL=info
# RAILS_LOG_TO_STDOUT=1
# RAILS_SERVE_STATIC_FILES=1
