/ Update metadata cells directly if they were updated via dropdowns
- if @test_case.saved_change_to_test_type?
  = turbo_stream.replace "test-case-#{@test_case.id}-test_type-cell" do
    = render 'test_cases/metadata_dropdown', test_case: @test_case, field: 'test_type'

- if @test_case.saved_change_to_target?
  = turbo_stream.replace "test-case-#{@test_case.id}-target-cell" do
    = render 'test_cases/metadata_dropdown', test_case: @test_case, field: 'target'

/ Update the title display and grouping if it was updated via inline editing
- if @test_case.saved_change_to_title? || @test_case.saved_change_to_group_description?
  = turbo_stream.update "test-cases-spreadsheet-container" do
    - if @all_test_cases.any? || @show_archived
      .card.border-0.shadow-sm.mb-4#test-cases
        .card-header.bg-white.py-3
          .d-flex.justify-content-between.align-items-center
            h5.mb-0.fw-bold.text-primary
              i.bi.bi-grid-3x3-gap.me-2
              | Test Cases 
              span.badge.bg-primary.bg-opacity-10.text-primary.ms-2= @total_test_cases
            
            - if @total_tc_pages > 1
              .text-muted.small
                | Trang #{@test_cases_page}/#{@total_tc_pages}

            .d-flex.align-items-center.gap-2.ms-auto
              - if @show_archived
                = link_to project_task_path(@project, @task, show_archived: 0, tc_page: 1), class: "btn btn-primary btn-sm d-inline-flex align-items-center" do
                  i.bi.bi-eye-fill.me-1
                  | Viewing Archived (#{@total_test_cases})
              - else
                = link_to project_task_path(@project, @task, show_archived: 1, tc_page: 1), class: "btn btn-outline-secondary btn-sm d-inline-flex align-items-center" do
                  i.bi.bi-archive.me-1
                  | Show Archived
                  - if @task.test_cases.deleted.any?
                    span.badge.bg-secondary.ms-2 = @task.test_cases.deleted.count

        .card-body.p-0
          - devices = @task.unique_devices
          - tc_start_index = (@test_cases_page - 1) * @test_cases_per_page
          = render 'test_cases/spreadsheet_table', test_cases: @paginated_test_cases, devices: devices, start_index: tc_start_index
        
        - if @total_tc_pages > 1
          .card-footer.bg-white.border-top-0
            = render 'shared/pagination', page: @test_cases_page, total_pages: @total_tc_pages, param_name: 'tc_page', anchor: 'test-cases'

/ Default modal handling
- unless @test_case.saved_changes.keys.intersect?(['test_type', 'target', 'title', 'group_description']) && @test_case.saved_changes.keys.size == 1
  / Only reload if it was a complex update (e.g. from modal)
  = turbo_stream.replace "test_case_modal_content" do
    = turbo_frame_tag "test_case_modal_content" do
      .modal-body.text-center.py-5
        .spinner-border.text-primary role="status"
          span.visually-hidden Loading...
        .mt-2 Updating...
        script
          | window.location.reload();
