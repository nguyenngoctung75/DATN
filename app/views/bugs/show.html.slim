- bug_presenter = BugPresenter.new(@bug)
.container.py-4
  nav aria-label="breadcrumb"
    ol.breadcrumb
      li.breadcrumb-item = link_to 'Projects', projects_path
      li.breadcrumb-item.text-truncate.breadcrumb-truncate-sm = link_to @project.name, project_path(@project), title: @project.name
      li.breadcrumb-item.text-truncate.breadcrumb-truncate-md = link_to @task.title, project_task_path(@project, @task), title: @task.title
      li.breadcrumb-item = link_to 'Bugs', project_task_bugs_path(@project, @task)
      li.breadcrumb-item.active aria-current="page" Bug ##{@bug.id}

  .d-flex.flex-column.flex-md-row.justify-content-between.align-items-start.align-items-md-center.gap-3.mb-4
    .d-flex.align-items-center.flex-grow-1.min-width-0
      h2.mb-0.me-3.text-truncate title="Bug ##{@bug.id}"
        i.bi.bi-bug.text-danger.me-2
        | Bug ##{@bug.id}
      .d-flex.gap-2
        span.badge class="bg-#{bug_presenter.status_color}" = @bug.status.titleize
        span.badge class="bg-#{bug_presenter.priority_color}" = @bug.priority.titleize

  .d-flex.gap-2
    = link_to edit_project_task_bug_path(@project, @task, @bug), class: 'btn btn-outline-primary' do
      i.bi.bi-pencil.me-1
      | Edit
    = link_to project_task_bug_path(@project, @task, @bug), data: { turbo_method: :delete, turbo_confirm: 'Are you sure you want to delete this bug?' }, class: 'btn btn-outline-danger' do
      i.bi.bi-trash.me-1
      | Delete

.row
  .col-md-8
    .card.shadow-sm.mb-4
      .card-header.bg-white
        h5.mb-0 Detailed Content
      .card-body
        .bug-content.whitespace-pre-wrap
          - if @bug.content.present?
            = simple_format @bug.content
          - else
            i.text-muted No detailed content.

    - if @bug.image_video_url.present?
      - normalized_url = @bug.image_video_url.strip
      - normalized_url = "https://#{normalized_url}" unless normalized_url.match?(%r{\Ahttps?://}i)
      .card.shadow-sm.mb-4
        .card-header.bg-white
          h5.mb-0 Image / Video
        .card-body
          .mb-2
            span.small.text-muted.me-2 Original link:
            = link_to normalized_url, normalized_url, target: '_blank', rel: 'noopener noreferrer', class: 'small text-decoration-none'
          .media-preview.mt-3
            = render_media(normalized_url)

    - if @bug.notes.present?
      .card.shadow-sm.mb-4
        .card-header.bg-white
          h5.mb-0 Notes
        .card-body
          = simple_format @bug.notes

    / Activity History
    .card.shadow-sm.mb-4
      .card-body
        = render 'shared/activity_timeline', logs: ActivityLog.where(trackable: @bug).includes(:user).limit(50)

  .col-md-4
    .card.shadow-sm.mb-4
      .card-header.bg-light
        h6.mb-0 Properties
      .card-body.p-0
        table.table.table-borderless.mb-0
          tbody
            tr
              th.ps-3 Scope:
              td = bug_presenter.application_display
            tr
              th.ps-3 Category:
              td = bug_presenter.category_display
            tr
              th.ps-3 Developer:
              td
                - if @bug.dev
                  i.bi.bi-person-circle.me-1.text-primary
                  = @bug.dev.name
                - else
                  span.text-muted = @bug.dev_name_raw || 'Unassigned'
            tr
              th.ps-3 Tester:
              td
                - if @bug.tester
                  i.bi.bi-person-badge.me-1.text-success
                  = @bug.tester.name
                - else
                  span.text-muted = @bug.tester_name_raw || 'Unassigned'
            tr
              th.ps-3 Created at:
              td.text-muted = @bug.created_at.strftime("%d/%m/%Y %H:%M")
